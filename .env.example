# Pick a provider preset: gemini | groq | openrouter | openai | anthropic | ollama
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (any OpenAI-compatible endpoint works)
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=
# LLM_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Models to try if the main one is overloaded (comma-separated)
# LLM_FALLBACK_MODELS=gemini-2.5-flash
# A different model judges the finder's picks (recommended). Unset = finder judges itself.
# JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
# JUDGE_FALLBACK_MODELS=gemini-3.6-flash
